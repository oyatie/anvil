#!/bin/bash
# Blocks the two things that are mechanically detectable at commit time.
#
# 1. Agent working directories must never be tracked. Load-bearing content is
#    drained to a real home first; these hold scratch only.
# 2. A gitignored file that reaches the index is almost always an accident of
#    `git add -f` or a stale index entry.
#
# NOT enforced here, honestly: whether a commit mixes unrelated concerns.
# `git add -A` sweeping in someone else's in-flight work happened twice in one
# day, but a hook sees the index, not the intent behind it, and cannot judge
# relatedness. The mitigation is staging explicit paths, not a check.
set -uo pipefail

if [ -n "${ANVIL_SKIP_HOOKS:-}" ]; then exit 0; fi

AGENT_DIRS='^\.(claude|codex|cursor|grok|agents|beads|omc|omx)/'
staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

offending=$(echo "$staged" | grep -E "$AGENT_DIRS" || true)
if [ -n "$offending" ]; then
    echo "[pre-commit] REFUSED: agent directory files are staged."
    echo "$offending" | sed 's/^/             /'
    echo "             These must not reach the remote. Drain any load-bearing"
    echo "             content to a real home first, then leave the directory"
    echo "             untracked (it may stay on disk)."
    exit 1
fi

while IFS= read -r f; do
    [ -z "$f" ] && continue
    if git check-ignore -q "$f" 2>/dev/null; then
        echo "[pre-commit] REFUSED: '$f' is gitignored but staged."
        exit 1
    fi
done <<< "$staged"

if command -v cargo >/dev/null 2>&1 && [ -f Cargo.toml ]; then
    cargo fmt --check >/dev/null 2>&1 || {
        echo "[pre-commit] REFUSED: cargo fmt --check failed. Run 'cargo fmt'."; exit 1; }
fi
exit 0
