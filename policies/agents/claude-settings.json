{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(cargo run)",
      "Bash(cargo run *)",
      "Bash(cargo publish*)",
      "Bash(cargo install*)",
      "Bash(git push*)",
      "Bash(git clean*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git rm*)",
      "Bash(git rebase*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git stash drop*)",
      "Bash(git reflog expire*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(sed -i*)",
      "Bash(rg --replace*)",
      "Bash(perl -i*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -execdir*)",
      "Bash(find * -ok*)",
      "Bash(sort -o*)",
      "Bash(tee *)"
    ],
    "allow": [
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo test*)",
      "Bash(cargo nextest*)",
      "Bash(cargo clippy*)",
      "Bash(cargo metadata*)",
      "Bash(cargo tree*)",
      "Bash(cargo fmt --all -- --check)",
      "Bash(rustfmt --edition 2024*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git cat-file*)",
      "Bash(git ls-tree*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git check-ignore*)",
      "Bash(git grep*)",
      "Bash(git branch)",
      "Bash(git branch -r*)",
      "Bash(git branch --format*)",
      "Bash(git fetch*)",
      "Bash(git stash list*)",
      "Bash(git switch -c *)",
      "Bash(git commit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(grep*)",
      "Bash(rg *)",
      "Bash(wc*)",
      "Bash(sort)",
      "Bash(uniq*)",
      "Bash(cut*)",
      "Bash(tr *)",
      "Bash(paste*)",
      "Bash(bc*)",
      "Bash(diff *)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(cat *)",
      "Bash(ls*)",
      "Bash(echo*)",
      "Bash(printf*)",
      "Bash(sed -n *)",
      "Read"
    ]
  }
}
