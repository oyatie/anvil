#!/bin/sh
# Refuses to push a tree that is unformatted, does not compile, or fails clippy.
#
# A workflow agent pushed a branch whose main.rs called a method that did not
# exist; it stayed broken for hours because nothing between the edit and the
# remote checked. The instruction "do not push a broken tree" was in the
# agent's prompt and did not prevent it. This does.
#
# Ordered cheapest-first: formatting is seconds, clippy is minutes.
#
# Bypass with --no-verify only when you mean to push a known-broken tree.
set -eu
if [ -n "${ANVIL_SKIP_HOOKS:-}" ]; then exit 0; fi

command -v cargo >/dev/null 2>&1 || exit 0
[ -f Cargo.toml ] || exit 0

if base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) && [ -n "$base" ]; then
  :
elif git rev-parse --verify --quiet origin/dev >/dev/null; then
  base=origin/dev
else
  echo "pre-push: no upstream or origin/dev" >&2
  exit 1
fi

# Nothing Rust changed on this push: nothing here can fail.
if ! git diff --name-only --diff-filter=ACMR "$base"...HEAD -- '*.rs' | grep -q .; then
  exit 0
fi

echo "[pre-push] rustfmt --check on changed files..."
if [ -f rustfmt.toml ]; then
  git diff --name-only -z --diff-filter=ACMR "$base"...HEAD -- '*.rs' \
    | xargs -0 rustfmt --check --config-path rustfmt.toml --
else
  git diff --name-only -z --diff-filter=ACMR "$base"...HEAD -- '*.rs' \
    | xargs -0 rustfmt --check --
fi

echo "[pre-push] checking the tree compiles..."
if ! cargo check --all-targets --locked --quiet; then
    echo "[pre-push] REFUSED: the tree does not compile."
    echo "           Pushing a non-compiling branch wastes every downstream reader's time."
    exit 1
fi

# Clippy too, not just rustc.
#
# This hook checked only `cargo check` and let a `-D warnings` failure reach the
# remote -- an `async_fn_in_trait` lint that CI treats as fatal. A gate that
# passes what the next gate will fail is worse than no gate: it teaches the
# reader that green means safe.
#
# Exit status is captured explicitly rather than relying on a pipeline: piping
# through `tail` is exactly how the first version of this check would have
# swallowed the failure.
echo "[pre-push] checking clippy -D warnings..."
set +e
clippy_out=$(cargo clippy --all-targets --locked --quiet -- -D warnings 2>&1)
clippy_rc=$?
set -e
if [ "$clippy_rc" -ne 0 ]; then
    echo "$clippy_out" | tail -20
    echo "[pre-push] REFUSED: clippy -D warnings failed."
    echo "           CI treats these as fatal; catching them here costs seconds, not a round trip."
    exit 1
fi

# The governance scans that need no network and no service.
#
# These were CI-only, and a class caught in CI has already been written,
# committed, pushed and put in front of a reviewer -- the run reports that it
# happened, and every report is another wave of fixes. They read source and
# nothing else, so the only reason they are here rather than in `pre-commit` is
# that they need the test harness compiled, which this hook has already paid
# for one step above.
#
# Named individually rather than running the suite: this hook must stay in
# seconds once the tree is warm, and the full corpus is minutes.
echo "[pre-push] governance scans (duplication, prose counts, attribution)..."
set +e
scan_out=$(cargo test --locked --quiet \
    --test diff_parsing_ratchet_test \
    --test prose_counts_test \
    --test source_scan_test \
    --test removals_are_not_reachable_by_accident_test \
    --test postmortem_ledger_test 2>&1)
scan_rc=$?
set -e
if [ "$scan_rc" -ne 0 ]; then
    echo "$scan_out" | tail -30
    echo "[pre-push] REFUSED: a governance scan failed."
    echo "           These read source only. Failing here costs seconds; failing in CI costs"
    echo "           a round trip and a second wave of fixes."
    exit 1
fi

exit 0
