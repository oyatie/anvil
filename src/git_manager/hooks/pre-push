#!/bin/sh
# Refuses to push a tree that is unformatted, does not compile, or fails clippy.
#
# A workflow agent pushed a branch whose main.rs called a method that did not
# exist; it stayed broken for hours because nothing between the edit and the
# remote checked. The instruction "do not push a broken tree" was in the
# agent's prompt and did not prevent it. This does.
#
# Ordered cheapest-first: formatting is seconds, clippy is minutes.
#
# Bypass with --no-verify only when you mean to push a known-broken tree.
set -eu
if [ -n "${ANVIL_SKIP_HOOKS:-}" ]; then exit 0; fi

command -v cargo >/dev/null 2>&1 || exit 0
[ -f Cargo.toml ] || exit 0

if base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) && [ -n "$base" ]; then
  :
elif git rev-parse --verify --quiet origin/dev >/dev/null; then
  base=origin/dev
else
  echo "pre-push: no upstream or origin/dev" >&2
  exit 1
fi

# Claims published in docs/plan, checked before the Rust gate below.
#
# It has to sit above that gate rather than inside it. Everything after this
# point is skipped when no `*.rs` changed, and `docs/plan/` is outside
# `corpus_sync::OWNED` with no test reading it -- so a docs-only push passed
# through this hook AND through CI untouched. Seven consecutive docs-only
# pushes on #207/#209 carried six wrong published numbers to the remote that
# way, each found afterwards by a reviewer.
#
# Cost, measured rather than asserted: ~40ms once the harness is built, but a
# full cold build (1m08s on a fresh worktree) when it is not -- and a docs-only
# push is exactly when the tree may be cold, because nothing else here compiles
# it. That breaks the "seconds once warm" promise the block below makes, for
# the docs-only path only, and is the stated price of catching the class before
# it reaches the remote rather than after.
# The `-f` guard is load-bearing, not defensive. This hook is installed once in
# .git/hooks and runs on every branch, including every branch that predates the
# test -- and `cargo test --test X` where X does not exist fails, which refused
# the push of an unrelated docs branch the first time it ran.
#
# A check that cannot run must decline, not block -- and "cannot run" is
# separated from "ran and failed" STRUCTURALLY, by building first and running
# second, rather than by matching the failure text. Matching text would tie the
# distinction to a message that changes. Before this split, a tree that did not
# compile printed "a number published beside a command is not what that command
# produces" and refused the push: the same conflation the `-f` guard above was
# added to fix, one layer in.
#
# hook_liveness.rs is NOT what enforces this. It checks that hooks are
# installed, executable, and undrifted from their template -- nothing about
# declining. This rule lives here and is measured by the seeded compile failure
# recorded in the commit that split it.
if [ -f tests/published_commands_reproduce_test.rs ] \
   && git diff --name-only --diff-filter=ACMR "$base"...HEAD -- 'docs/plan/' | grep -q .; then
  echo "[pre-push] published commands reproduce their numbers..."
  set +e
  build_out=$(cargo test --locked --quiet --no-run \
      --test published_commands_reproduce_test \
      --test docs_claims_hardening_test 2>&1)
  build_rc=$?
  set -e
  if [ "$build_rc" -ne 0 ]; then
      echo "$build_out" | tail -20
      echo "[pre-push] DECLINED: the docs-claim gate could not be built, so it"
      echo "           measured nothing. Not blocking on absent evidence -- but"
      echo "           nothing here vouched for the numbers either. CI runs this"
      echo "           on the merge commit."
  else
      set +e
      claim_out=$(cargo test --locked --quiet \
          --test published_commands_reproduce_test \
          --test docs_claims_hardening_test 2>&1)
      claim_rc=$?
      set -e
      if [ "$claim_rc" -ne 0 ]; then
          echo "$claim_out" | tail -30
          echo "[pre-push] REFUSED: a number published beside a command is not what that"
          echo "           command produces. Fix the number, or the command that cannot"
          echo "           express it."
          exit 1
      fi
  fi
fi

# Nothing Rust changed on this push: nothing below here can fail.
if ! git diff --name-only --diff-filter=ACMR "$base"...HEAD -- '*.rs' | grep -q .; then
  exit 0
fi

echo "[pre-push] rustfmt --check on changed files..."
# rustfmt is a standalone binary: invoked on a file list it never reads
# Cargo.toml, so it parses as Rust 2015 unless told otherwise. This repo is
# edition 2024, so every file holding `async fn` or a let-chain FAILED TO
# PARSE -- the check reported errors rather than formatting, on every modern
# file, and had done since the edition moved. Derived from the manifest rather
# than hardcoded so it cannot drift from it again.
edition=$(sed -n 's/^edition[[:space:]]*=[[:space:]]*"\([0-9]*\)".*/\1/p' Cargo.toml | head -1)
[ -n "$edition" ] || edition=2015
if [ -f rustfmt.toml ]; then
  git diff --name-only -z --diff-filter=ACMR "$base"...HEAD -- '*.rs' \
    | xargs -0 rustfmt --edition "$edition" --check --config-path rustfmt.toml --
else
  git diff --name-only -z --diff-filter=ACMR "$base"...HEAD -- '*.rs' \
    | xargs -0 rustfmt --edition "$edition" --check --
fi

echo "[pre-push] checking the tree compiles..."
if ! cargo check --all-targets --locked --quiet; then
    echo "[pre-push] REFUSED: the tree does not compile."
    echo "           Pushing a non-compiling branch wastes every downstream reader's time."
    exit 1
fi

# Clippy too, not just rustc.
#
# This hook checked only `cargo check` and let a `-D warnings` failure reach the
# remote -- an `async_fn_in_trait` lint that CI treats as fatal. A gate that
# passes what the next gate will fail is worse than no gate: it teaches the
# reader that green means safe.
#
# Exit status is captured explicitly rather than relying on a pipeline: piping
# through `tail` is exactly how the first version of this check would have
# swallowed the failure.
echo "[pre-push] checking clippy -D warnings..."
set +e
clippy_out=$(cargo clippy --all-targets --locked --quiet -- -D warnings 2>&1)
clippy_rc=$?
set -e
if [ "$clippy_rc" -ne 0 ]; then
    echo "$clippy_out" | tail -20
    echo "[pre-push] REFUSED: clippy -D warnings failed."
    echo "           CI treats these as fatal; catching them here costs seconds, not a round trip."
    exit 1
fi

# The governance scans that need no network and no service.
#
# These were CI-only, and a class caught in CI has already been written,
# committed, pushed and put in front of a reviewer -- the run reports that it
# happened, and every report is another wave of fixes. They read source and
# nothing else, so the only reason they are here rather than in `pre-commit` is
# that they need the test harness compiled, which this hook has already paid
# for one step above.
#
# Named individually rather than running the suite: this hook must stay in
# seconds once the tree is warm, and the full corpus is minutes.
echo "[pre-push] governance scans (duplication, prose counts, attribution)..."
set +e
scan_out=$(cargo test --locked --quiet \
    --test diff_parsing_ratchet_test \
    --test prose_counts_test \
    --test source_scan_test \
    --test removals_are_not_reachable_by_accident_test \
    --test postmortem_ledger_test \
    --test gate_proof_test 2>&1)
scan_rc=$?
set -e
if [ "$scan_rc" -ne 0 ]; then
    echo "$scan_out" | tail -30
    echo "[pre-push] REFUSED: a governance scan failed."
    echo "           These read source only. Failing here costs seconds; failing in CI costs"
    echo "           a round trip and a second wave of fixes."
    exit 1
fi

exit 0
